<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.FrmAvisoPet"
             NavigationPage.HasNavigationBar="False"
             Title="Novo Agendamento">

    <Grid RowDefinitions="Auto, *, Auto" Padding="25" RowSpacing="20">

        <!-- Topo -->
        <Label Grid.Row="0" 
               Text="VanderPET" 
               FontSize="26" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="#4A90E2" />

        <!-- Mensagem Central (Protótipo Imagem 2) -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="15">
            <Label Text="NOVO AGENDAMENTO" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Label Text="Você ainda não possui pet." 
                   FontSize="16" 
                   HorizontalOptions="Center" 
                   TextColor="Gray" />

            <Label Text="Para realizar um agendamento, você precisa cadastrar um Pet." 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" 
                   TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Botões de Ação -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Border Stroke="#4A90E2" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Button Text="+ CADASTRAR PET" 
                        Clicked="OnCadastrarPetClicked" 
                        BackgroundColor="Transparent"
                        TextColor="#4A90E2"
                        FontAttributes="Bold"
                        HeightRequest="45" />
            </Border>

            <Button Text="Voltar" 
                    Clicked="OnVoltarClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="Gray"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>