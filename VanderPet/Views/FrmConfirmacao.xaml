<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.FrmConfirmacao"
             Title="Agendamento Realizado"
             NavigationPage.HasBackButton="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="25" RowSpacing="20">

        <!-- Topo -->
        <Label Grid.Row="0" 
               Text="VanderPET" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="#4A90E2" />

        <!-- Card de Confirmação (Protótipo Imagem 3 - Topo) -->
        <Border Grid.Row="1" Stroke="#4A90E2" StrokeThickness="1" VerticalOptions="Center" Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                <Label Text="✓" 
                       FontSize="40" 
                       TextColor="Green" 
                       HorizontalOptions="Center" />

                <Label Text="Agendamento Realizado" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />

                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5" />

                <Label Text="Pet: Thor" FontSize="16" HorizontalOptions="Center" />
                <Label Text="Serviço: Banho e Tosa" FontSize="16" HorizontalOptions="Center" />
                <Label Text="Data: 28/08/2026" FontSize="16" HorizontalOptions="Center" />
                <Label Text="Horário: 14:00" FontSize="16" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Border>

        <!-- Botão OK -->
        <Border Grid.Row="2" Stroke="#4A90E2" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Button Text="OK" 
                    Clicked="OnOkClicked" 
                    BackgroundColor="Transparent"
                    TextColor="#4A90E2"
                    FontAttributes="Bold"
                    HeightRequest="45" />
        </Border>

    </Grid>
</ContentPage>